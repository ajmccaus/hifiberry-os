// audio-os: lets the helper's user restart/signal touch-timeout and reboot/power off, nothing else.
// systemd 257 passes details "unit" and "verb" (try-restart, restart, kill) for manage-units;
// the *-multiple-sessions actions apply because the kiosk holds a session on tty1.
polkit.addRule(function (action, subject) {
    if (subject.user !== "audio-os") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "touch-timeout.service" &&
        ["restart", "try-restart", "kill"].indexOf(action.lookup("verb")) >= 0) {
        return polkit.Result.YES;
    }
    if (["org.freedesktop.login1.reboot",
         "org.freedesktop.login1.reboot-multiple-sessions",
         "org.freedesktop.login1.power-off",
         "org.freedesktop.login1.power-off-multiple-sessions"].indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
