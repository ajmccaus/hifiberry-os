# Panel kiosk: cage + cog on http://localhost/ as user kiosk in a logind session on tty1. Skipped by
# ExecCondition when no DRM connector is connected (no restart loop); "+" pre-commands open no session.
# WantedBy multi-user: a cloud-init user creation runs raspi-config, which resets the default target.
[Unit]
Description=audio-os kiosk on tty1
After=systemd-user-sessions.service plymouth-quit-wait.service nginx.service getty@tty1.service
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
Group=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
Environment=XDG_SESSION_TYPE=wayland
StateDirectory=kiosk
ExecCondition=+/bin/sh -c 'grep -qsx connected /sys/class/drm/card*-*/status'
ExecStartPre=+/usr/lib/audio-os/kiosk-rotation touch
ExecStart=/usr/bin/cage -- /usr/lib/audio-os/kiosk-session
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
