// audio-os: unattended-upgrades installs Debian security updates only, never reboots.
// Raspberry Pi archive (kernel, bootloader firmware) and HiFiBerry packages are excluded: an
// unattended change there can stop a headless appliance from booting or playing, with no rollback.
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};
Unattended-Upgrade::Automatic-Reboot "false";
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
