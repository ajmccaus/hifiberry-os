# Beocreate classic UI on :8080 behind the hifiberry-auth gateway (ADR 0001).
# Installed as /etc/nginx/sites-available/beocreate (+ sites-enabled symlink).
# beo-server listens on loopback :8081 only; this block is its sole LAN door.
# - Own verify location, not 00-verify.conf: the gateway sees the synthetic
#   prefix /api/beocreate (manifest: /etc/hifiberry/auth.d/beocreate.json).
# - Loopback (the kiosk) is never gated.
# - Host $http_host, not $host: $host drops :8080 and the WebSocket Origin
#   check (communication.js) then refuses the browser.
map $http_upgrade $beocreate_connection { default upgrade; "" close; }
server {
    listen 8080; listen [::]:8080; server_name _;
    satisfy any; allow 127.0.0.1; allow ::1; deny all;
    auth_request /_beocreate_auth;
    error_page 401 = @beocreate_signin;
    location = /_beocreate_auth {
        internal;
        proxy_pass http://127.0.0.1:1089/_auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-URI /api/beocreate$request_uri;
    }
    # Policy "all" without a session: send the user to hbos-ui's sign-in on :80.
    location @beocreate_signin { return 302 http://$host/; }
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $beocreate_connection;
        proxy_set_header Host $http_host;
    }
}
