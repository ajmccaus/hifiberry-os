#cloud-config
# audio-os first-boot settings, applied once by cloud-init on the first start.
# Everything is off by default. To use a block, delete the leading "# " on its lines and keep the
# indentation exactly (spaces only, never tabs). Wi-Fi is set in the file "network-config".
#
# Create a login user with your SSH public key and switch SSH on (key-only: passwords are refused).
# Pick your own name, but not "player", "kiosk" or "audio-os" (the appliance uses those).
# The line after "ssh_authorized_keys:" is the content of your ~/.ssh/id_ed25519.pub (one line).
#
# users:
#   - name: alice
#     groups: [adm, sudo]
#     sudo: "ALL=(ALL) NOPASSWD:ALL"
#     shell: /bin/bash
#     lock_passwd: true
#     ssh_authorized_keys:
#       - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyReplaceMe alice@laptop
# enable_ssh: true
#
# Then connect with:  ssh alice@hifiberry.local
