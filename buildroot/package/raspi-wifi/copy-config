#!/bin/bash

# Consume provisioning files the user dropped on the FAT partition.
# /boot may be ro or rw depending on boot phase; remount rw to be able
# to remove the consumed files, and leave the mount state to the rest
# of the boot flow. If the file can't be removed it is simply applied
# again on the next boot.
printf "Looking for configuration files on /boot: "
if [ -f /boot/wpa_supplicant.conf ] || [ -f /boot/systemname ]; then
    mount -o remount,rw /boot 2>/dev/null
fi

if [ -f "/boot/wpa_supplicant.conf" ]; then
    cp /boot/wpa_supplicant.conf /etc/wpa_supplicant.conf && rm -f /boot/wpa_supplicant.conf
fi

if [ -f "/boot/systemname" ]; then
    cp /boot/systemname /etc/systemname && rm -f /boot/systemname
fi
