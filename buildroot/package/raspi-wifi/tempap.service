[Unit]
Description=Temporay access point for configuration
Wants=network.target
After=network.target tempap-hostapd.service tempap-dnsmasq.service
Requires=tempap-hostapd.service tempap-dnsmasq.service
ConditionPathExists=!/boot/noap

[Service]
Type=oneshot
# Stay "active" after /bin/true exits so `systemctl stop tempap` is not a
# no-op and stop propagates to the PartOf= sub-services (hostapd, dnsmasq).
RemainAfterExit=yes
# Execute a dummy program
ExecStart=/bin/true

[Install]
